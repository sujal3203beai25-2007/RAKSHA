
# ==============================================================================
# RAKSHA Healthcare Access Platform - Environment Configuration (SIH 2026)
# ==============================================================================

# Server Environment (development | test | production)
PORT=3000
NODE_ENV=development

# Demo mode: enabled for local demonstration only
DEMO_MODE=true

# Security & Authentication
# Replace these placeholders with unique, strong secrets for deployment.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
SESSION_SECRET=replace_with_a_different_random_secret
STAFF_VERIFICATION_KEY=replace_with_a_private_staff_registration_key

# CORS Origin Whitelist
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistent Database File (SQLite)
DATABASE_PATH=./server/data/raksha.db

# Geospatial External Services
NOMINATIM_USER_AGENT=RAKSHA-Healthcare-Access-Platform-SIH2026
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# External Emergency CAD / 108 Webhook (optional)
EMERGENCY_CAD_WEBHOOK_URL=
EMERGENCY_CAD_API_KEY=

# ABDM / ABHA Sandbox Configuration (optional)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
